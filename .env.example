# RefactorCsharpMCP Environment Configuration
# Copy this file to .env and update values as needed

# Optional: Private Claude Code configuration repository
# If set, bootstrap_private_config.sh will clone/update private settings
# Leave unset for standard public repository usage
# PRIVATE_CLAUDE_CONFIG_REPO_URL=https://github.com/your-username/your-private-config-repo

# Optional: Branch for private config repository (default: main)
# PRIVATE_CONFIG_BRANCH=main

# MCP Server Environment Variables (set these if using MCP integrations)
# GITHUB_MCP_URL=
# GITHUB_MCP_TOKEN=
# DOCKER_MCP_TOOLKIT_URL=

# Optional Azure DevOps integration
# AZURE_DEVOPS_MCP_URL=
# AZURE_DEVOPS_PAT=

# Optional Notion integration
# NOTION_MCP_URL=
# NOTION_MCP_TOKEN=

# Optional Slack integration
# SLACK_MCP_URL=
# SLACK_BOT_TOKEN=
