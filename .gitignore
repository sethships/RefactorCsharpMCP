## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Claude Code configuration
# Ignore local/personal settings but allow team-wide settings.json
.claude/settings.local.json
.claude/*.local.json
.claude/cache/
.claude/logs/

# Local tool installations (created by scripts/install_tools.sh)
.tools/

# Code review feedback files
review-feedback*.md

# Rider
.idea/

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!?*.[Cc]ache/

# Others
*.log
*.tlog
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# DocProject is a documentation generator add-in
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# Publish profiles
PublishProfiles/

# Backup & report files from converting an old project file
# to a newer Visual Studio version.
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# Node.js Tools for Visual Studio
.ntvs_analysis.dat
node_modules/

# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# JetBrains Rider
*.sln.iml
coverage-report/

# Deployment and Security Scanning Outputs
deployment.log
security-scout*.txt
security-trivy*.txt
security-recommendations*.txt
image-layers*.txt
sbom*.json
sbom*.xml
sbom*.csv
sbom-output/

# Build output / publish directory
app/
publish/

# Test harness temporary output
TestBug118/refactored-output.cs
